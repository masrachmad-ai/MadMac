# Salin file ini menjadi .env DI SERVER, lalu isi. JANGAN pernah commit .env
# dan JANGAN kirim isinya ke chat mana pun.

# Binance Futures TESTNET (testnet.binancefuture.com)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Binance LIVE — biarkan KOSONG sampai Anda memutuskan "go live".
# Saat membuat key: centang HANYA "Enable Futures". JANGAN centang Withdrawals.
# Aktifkan "Restrict access to trusted IPs" dan isi IP server Anda.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Telegram (lihat docs/DEPLOY.md langkah 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
